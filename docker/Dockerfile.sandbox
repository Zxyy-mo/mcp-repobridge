FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    git \
    ripgrep \
    util-linux \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN if ! id -u 1000 >/dev/null 2>&1; then useradd -m -u 1000 sandbox; fi
WORKDIR /workspace
USER 1000:1000

CMD ["sleep", "infinity"]
